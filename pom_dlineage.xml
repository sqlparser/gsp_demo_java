<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
        <groupId>gudusoft</groupId>
        <artifactId>gsp_java</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

  <groupId>gudusoft</groupId>
  <artifactId>gsp_demo_java_dlineage</artifactId>
  <name>Gudu Software Parser for Java Demo - dlineage only</name>
  <description>Compile and run only dlineage demo</description>
  <url>https://www.sqlparser.com</url>
  <version>1.0-SNAPSHOT</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <maven.test.skip>true</maven.test.skip>
        <gsp.core.version>4.1.6</gsp.core.version>
    </properties>

    <!-- The parser is not on Maven Central; it comes from Gudu's public
         repository, same as the root pom.xml. Nothing is vendored under lib/. -->
    <repositories>
        <repository>
            <id>gudu-public-releases</id>
            <url>https://www.sqlparser.com/maven/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.gudusoft</groupId>
            <artifactId>gsqlparser</artifactId>
            <version>${gsp.core.version}</version>
        </dependency>

        <dependency>
            <groupId>org.simpleframework</groupId>
            <artifactId>simple-xml</artifactId>
            <version>2.7.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/simple-xml-2.7.1.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
            <version>1.2.83</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/fastjson-1.2.83.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>com.github.junrar</groupId>
            <artifactId>junrar</artifactId>
            <version>7.5.10</version>
        </dependency>

        <dependency>
            <groupId>org.boris</groupId>
            <artifactId>expr</artifactId>
            <version>0.0.0-vendored</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/expr4j.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>org.jdom</groupId>
            <artifactId>jdom2</artifactId>
            <version>2.0.6.1</version>
        </dependency>

        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.2</version>
            <scope>compile</scope>
        </dependency>

    </dependencies>

    <build>
        <!-- This POM shares ${project.basedir} with the root pom.xml, so without
             an explicit, separate output directory it also shares target/classes.
             It declares only one source file (see the compiler <includes> below),
             so the compiler plugin's incremental-compilation cleanup deletes every
             .class file the root build produced that isn't part of this smaller
             source set, before this build even reaches its own compile error.
             That wipes out a working root build with no indication of why. See
             https://github.com/sqlparser/gsp_demo_java/issues/39. -->
        <directory>${project.basedir}/target-dlineage</directory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <includes>
                      <include>gudusoft/gsqlparser/demos/dlineage/DataFlowAnalyzer.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-surefire-plugin</artifactId>
              <version>3.0.0-M5</version>
              <configuration>
                <skipTests>true</skipTests>
              </configuration>
            </plugin>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-jar-plugin</artifactId>
              <version>3.3.0</version>
              <configuration>
                <archive>
                  <manifest>
                    <mainClass>gudusoft.gsqlparser.demos.dlineage.DataFlowAnalyzer</mainClass>
                  </manifest>
                </archive>
              </configuration>
            </plugin>
            <plugin>
              <groupId>org.codehaus.mojo</groupId>
              <artifactId>exec-maven-plugin</artifactId>
              <version>3.1.0</version>
              <configuration>
                <mainClass>gudusoft.gsqlparser.demos.dlineage.DataFlowAnalyzer</mainClass>
              </configuration>
            </plugin>
        </plugins>
    </build>

</project>


