<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>gudusoft</groupId>
	<artifactId>gudusoft.gsqlparser.demo.snowflakeConnector</artifactId>
	<version>1.0-SNAPSHOT</version>
	<packaging>jar</packaging>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<project.name>Gsp Snowflake Connector Demo</project.name>
		<project.version>1.0</project.version>
		<project.organization.name>Gudu software</project.organization.name>
		<maven.compiler.source>1.6</maven.compiler.source>
		<maven.compiler.target>1.6</maven.compiler.target>
	</properties>

	<repositories>
		<repository>
			<id>gudu-public-releases</id>
			<url>https://www.sqlparser.com/maven/</url>
		</repository>
	</repositories>

	<dependencies>
		<!-- The parser is resolved from Gudu's public Maven repository. It used to
		     point at ../../lib/gudusoft.gsqlparser-2.1.2.x.jar, a file this
		     repository has not contained for a long time. -->
		<dependency>
			<groupId>com.gudusoft</groupId>
			<artifactId>gsqlparser</artifactId>
			<version>4.1.9</version>
		</dependency>
		<!-- Resolved from Maven Central rather than a jar you drop into lib/.
		     3.12.9 was named here before, which Dependabot flagged for six
		     advisories (the most severe fixed in 3.13.29, the broadest covering
		     everything up to 4.0.1). Since the jar was never vendored in this
		     repository, the declared version was only ever an instruction about
		     what to download; letting Maven fetch it removes both the stale
		     instruction and the manual step. -->
		<dependency>
            <groupId>net.snowflake</groupId>
            <artifactId>snowflake-jdbc</artifactId>
			<version>4.3.2</version>
		</dependency>
	</dependencies>

	<build>
		<finalName>snowflakeConnector</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<classesDirectory>target/classes/</classesDirectory>
					<archive>
						<manifest>
							<mainClass>demos.connector.SnowflakeDataSourceConnector</mainClass>
							<useUniqueVersions>false</useUniqueVersions>
							<addClasspath>true</addClasspath>
							<classpathPrefix>lib/</classpathPrefix>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.5.1</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>