<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- No <parent>. This repository used to inherit from gudusoft:gsp_java,
       the private library reactor, which is why it could not be built by
       anyone outside Gudu: Maven could not resolve the parent POM. It now
       stands on its own and takes the parser from Gudu's public Maven
       repository, declared below. -->

  <groupId>gudusoft</groupId>
  <artifactId>gsp_demo_java</artifactId>
  <name>Gudu Software Parser for Java Demo</name>
  <description>Gudu Software Parser for Java Demo</description>
  <url>https://www.sqlparser.com</url>
  <version>1.0-SNAPSHOT</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<project.name>Gudu Software Parser for Java Demo</project.name>
		<project.organization.name>Gudu software</project.organization.name>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
		<maven.build.timestamp.format>yyyy-MMM-dd HH:mm z</maven.build.timestamp.format>
        <!-- Bump this to move every demo to a newer parser. Available versions:
             https://www.sqlparser.com/maven/com/gudusoft/gsqlparser/maven-metadata.xml -->
        <gsp.core.version>4.1.6</gsp.core.version>
    </properties>

    <!-- Gudu's public Maven repository. The parser is not on Maven Central. -->
    <repositories>
        <repository>
            <id>gudu-public-releases</id>
            <url>https://www.sqlparser.com/maven/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- The parser itself. This is the trial build: fully functional for
             evaluation, and enough for every demo here. The public Maven
             version is a three-part number and does not necessarily match the
             four-part product version in the release notes. -->
        <dependency>
            <groupId>com.gudusoft</groupId>
            <artifactId>gsqlparser</artifactId>
            <version>${gsp.core.version}</version>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.12</version>
            <scope>test</scope>
        </dependency>


        <dependency>
            <groupId>org.simpleframework</groupId>
            <artifactId>simple-xml</artifactId>
            <version>2.6.2</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/simple-xml-2.6.2.jar</systemPath>
        </dependency>

<!-- https://mvnrepository.com/artifact/com.alibaba/fastjson -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
            <version>1.2.41</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/fastjson-1.2.41.jar</systemPath>            
        </dependency>
        <!-- https://mvnrepository.com/artifact/com.github.junrar/junrar -->
    <dependency>
        <groupId>com.github.junrar</groupId>
        <artifactId>junrar</artifactId>
        <version>0.7</version>
        <scope>system</scope>
        <systemPath>${project.basedir}/lib/junrar-0.7.jar</systemPath>     
    </dependency>

    <!-- https://mvnrepository.com/artifact/tk.pratanumandal/expr4j -->
    <dependency>
        <groupId>tk.pratanumandal</groupId>
        <artifactId>expr4j</artifactId>
        <version>0.0.3</version>
                <scope>system</scope>
        <systemPath>${project.basedir}/lib/expr4j.jar</systemPath>  
    </dependency>
<!-- https://mvnrepository.com/artifact/org.jdom/jdom -->
        <dependency>
            <groupId>org.jdom</groupId>
            <artifactId>jdom</artifactId>
            <version>1.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/jdom.jar</systemPath>  
        </dependency>


        <dependency>
            <groupId>sqlflow</groupId>
            <artifactId>exporter</artifactId>
            <version>1.0.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/sqlflow-exporter.jar</systemPath>            
        </dependency>
        <dependency>
            <groupId>sqlflow</groupId>
            <artifactId>library</artifactId>
            <version>1.0.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/sqlflow-library.jar</systemPath>            
        </dependency>        

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <excludes>
                        <!-- demos/dbConnect wires the parser up to live databases
                             over JDBC to grab metadata. It is excluded from the
                             default build for two reasons: it needs JDBC drivers
                             and a reachable server to do anything, and it is
                             written against gudusoft.gsqlparser.sqlenv.util,
                             which the current public parser no longer ships.
                             Reviving it needs an API migration, not a rebuild. -->
                        <exclude>demos/dbConnect/**</exclude>

                        <!-- Same story, three stragglers outside dbConnect: they
                             build a TSQLDataSource / T<Vendor>SQLDataSource to
                             read metadata straight out of a running database.
                             The public parser ships no *SQLDataSource class at
                             all, so these cannot compile against it, and they
                             would need JDBC drivers and a live server to run.
                             Everything else in their packages still builds. -->
                        <exclude>demos/gettablecolumns/runGetTableColumn.java</exclude>
                        <exclude>demos/columninspect/ColumnInspect.java</exclude>
                        <exclude>demos/dlineage/DataFlowAnalyzer.java</exclude>
                    </excludes>
                    <testExcludes>
                        <!-- The same live-database metadata API, from the test
                             side: these five reach for TSQLEnv / TSQLDataSource
                             and their JDBC subclasses. Excluded so that a plain
                             `mvn package` works against the public parser. -->
                        <testExclude>gudusoft/gsqlparser/commonTest/testDBVendor.java</testExclude>
                        <testExclude>gudusoft/gsqlparser/gettablecolumnTest/testColumnResolver.java</testExclude>
                        <testExclude>gudusoft/gsqlparser/gettablecolumnTest/testNewTableColumn.java</testExclude>
                        <testExclude>gudusoft/gsqlparser/gettablecolumnTest/testSQLEnv.java</testExclude>
                        <testExclude>gudusoft/gsqlparser/sqlenvTest/testJSONEnv.java</testExclude>
                        <testExclude>gudusoft/gsqlparser/commonTest/ColumnImpactTest.java</testExclude>
                        <testExclude>gudusoft/gsqlparser/dlineageTest/testColumnLevelLineageFile.java</testExclude>
                        <testExclude>gudusoft/gsqlparser/gettablecolumnTest/testDbObject.java</testExclude>
                        <testExclude>gudusoft/gsqlparser/commonTest/metaDB.java</testExclude>
                        <testExclude>gudusoft/gsqlparser/gettablecolumnTest/getObject.java</testExclude>
                        <testExclude>gudusoft/gsqlparser/commonTest/testJoins.java</testExclude>
                        <testExclude>gudusoft/gsqlparser/commonTest/testMetaDB.java</testExclude>
                        <testExclude>gudusoft/gsqlparser/demosTest/removeCondition/testRemoveCondition.java</testExclude>
                        <testExclude>gudusoft/gsqlparser/gettablecolumnTest/testTC1.java</testExclude>
                    </testExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.1</version>
            </plugin>
        </plugins>
    </build>

</project>
