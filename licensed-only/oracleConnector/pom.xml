<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>gudusoft</groupId>
	<artifactId>gudusoft.gsqlparser.demo.oracleConnector</artifactId>
	<version>1.0-SNAPSHOT</version>
	<packaging>jar</packaging>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<project.name>Gsp Oracle Connector Demo</project.name>
		<project.version>1.0</project.version>
		<project.organization.name>Gudu software</project.organization.name>
		<maven.compiler.source>1.6</maven.compiler.source>
		<maven.compiler.target>1.6</maven.compiler.target>
	</properties>

	<repositories>
		<repository>
			<id>gudu-public-releases</id>
			<url>https://www.sqlparser.com/maven/</url>
		</repository>
	</repositories>

	<dependencies>
		<!-- The parser is resolved from Gudu's public Maven repository. It used to
		     point at ../../lib/gudusoft.gsqlparser-2.1.2.x.jar, a file this
		     repository has not contained for a long time. -->
		<dependency>
			<groupId>com.gudusoft</groupId>
			<artifactId>gsqlparser</artifactId>
			<version>4.2.6</version>
		</dependency>
		<!-- Resolved from Maven Central rather than a jar you drop into lib/.
		     This was com:ojdbc:1.1.1 on system scope, pointing at
		     lib/ojdbc-1.1.1.jar: a coordinate that exists in no repository and
		     a file this checkout has never contained, so the build died during
		     dependency resolution before it could say anything useful about
		     needing a licensed parser. Oracle publishes the driver now. -->
		<dependency>
			<groupId>com.oracle.database.jdbc</groupId>
			<artifactId>ojdbc8</artifactId>
			<version>21.18.0.0</version>
		</dependency>
	</dependencies>

	<build>
		<finalName>oracleConnector</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<classesDirectory>target/classes/</classesDirectory>
					<archive>
						<manifest>
							<mainClass>demos.connector.OracleDataSourceConnector</mainClass>
							<useUniqueVersions>false</useUniqueVersions>
							<addClasspath>true</addClasspath>
							<classpathPrefix>lib/</classpathPrefix>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.5.1</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<!-- These modules need a LICENSED parser. The public trial artifact this
	     repository resolves does not ship gudusoft.gsqlparser.sqlenv.T*SQLDataSource
	     or sqlenv.metadata.DDL, so the sources here cannot compile against it:
	     javac reports "cannot find symbol", which reads as a broken repository
	     rather than a licensing boundary. That is what a first-time evaluation
	     concluded in August 2026.

	     So the default build stops with an explanation instead. Build with
	     -Plicensed once you have a licensed parser installed and the JDBC
	     driver in lib/. -->
	<profiles>
		<profile>
			<id>trial-guard</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-enforcer-plugin</artifactId>
						<version>3.4.1</version>
						<executions>
							<execution>
								<id>licensed-parser-required</id>
								<phase>validate</phase>
								<goals>
									<goal>enforce</goal>
								</goals>
								<configuration>
									<rules>
										<alwaysFail>
											<message>This module needs a LICENSED General SQL Parser, not the public trial jar this repository resolves by default. The trial artifact does not ship gudusoft.gsqlparser.sqlenv.T*SQLDataSource, so these sources cannot compile against it. See licensed-only/README.md. To evaluate metadata-aware column resolution on the trial parser instead, run the columninspect demo with samples/columninspect/metadata.json. Once you have a licensed parser installed, build with -Plicensed.</message>
										</alwaysFail>
									</rules>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<!-- Activating any profile switches off activeByDefault above, which is
		     the whole mechanism: -Plicensed removes the guard. -->
		<profile>
			<id>licensed</id>
		</profile>
	</profiles>

</project>
